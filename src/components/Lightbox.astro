---
// Visualizzatore a schermo intero, condiviso da Opere e Stampa.
// Ogni elemento cliccabile ha: data-gallery (nome del gruppo), data-index (posizione),
// data-full (immagine grande), data-title e data-meta (didascalia in basso).
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="lb" role="dialog" aria-modal="true" aria-label={t(lang, 'enlarge')} hidden data-lb>
  <div class="lb-top">
    <span class="lb-count" data-lb-count></span>
    <button type="button" class="lb-btn" data-lb-close aria-label={t(lang, 'close')}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
  </div>

  <div class="lb-stage" data-lb-stage>
    <img class="lb-img" data-lb-img alt="" draggable="false" />
    <button type="button" class="lb-btn lb-nav lb-prev" data-lb-prev aria-label={t(lang, 'previous')}>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
    </button>
    <button type="button" class="lb-btn lb-nav lb-next" data-lb-next aria-label={t(lang, 'next')}>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
    </button>
  </div>

  <div class="lb-bottom">
    <p class="lb-cap"><span class="lb-title" data-lb-title></span><span class="lb-meta" data-lb-meta></span></p>
    <div class="lb-zoom">
      <button type="button" class="lb-btn" data-lb-zoomout aria-label={t(lang, 'zoomOut')}>−</button>
      <span data-lb-zoomlabel>100%</span>
      <button type="button" class="lb-btn" data-lb-zoomin aria-label={t(lang, 'zoomIn')}>+</button>
    </div>
  </div>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: #0f0f0e;
    color: #e4e1db;
    display: flex;
    flex-direction: column;
    user-select: none;
    -webkit-user-select: none;
  }
  .lb[hidden] {
    display: none;
  }
  .lb-top,
  .lb-bottom {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px clamp(12px, 2.5vw, 28px);
    min-height: 64px;
    position: relative;
    z-index: 2;
  }
  .lb-count {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #a79e91;
  }
  .lb-btn {
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: #e4e1db;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    line-height: 1;
    border-radius: 50%;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .lb-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    touch-action: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(8px, 7vw, 96px);
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    will-change: transform;
    cursor: zoom-in;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .lb-img.is-ready {
    opacity: 1;
  }
  .lb.is-zoomed .lb-img {
    cursor: grab;
  }
  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
  }
  .lb-prev {
    left: clamp(4px, 1.5vw, 24px);
  }
  .lb-next {
    right: clamp(4px, 1.5vw, 24px);
  }
  .lb.is-zoomed .lb-nav,
  .lb.is-single .lb-nav {
    display: none;
  }
  .lb-cap {
    font-size: 13px;
    color: #cfc8bd;
  }
  .lb-title {
    font-family: var(--serif);
    font-size: 17px;
    color: #fafaf8;
  }
  .lb-meta:not(:empty)::before {
    content: ' · ';
  }
  .lb-title:empty + .lb-meta::before {
    content: none;
  }
  .lb-zoom {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: #a79e91;
  }
  .lb-zoom span {
    min-width: 44px;
    text-align: center;
  }
  @media (max-width: 640px) {
    .lb-nav {
      display: none;
    }
    .lb-zoom span {
      display: none;
    }
  }
</style>

<script>
  type Item = { full: string; title: string; meta: string; alt: string };

  const root = document.querySelector<HTMLElement>('[data-lb]')!;
  const stage = root.querySelector<HTMLElement>('[data-lb-stage]')!;
  const image = root.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const countEl = q('[data-lb-count]');
  const titleEl = q('[data-lb-title]');
  const metaEl = q('[data-lb-meta]');
  const zoomLabel = q('[data-lb-zoomlabel]');

  let items: Item[] = [];
  let index = 0;
  let scale = 1;
  let tx = 0;
  let ty = 0;
  let lastFocus: HTMLElement | null = null;
  const MAX = 4;

  function elements(gallery: string): HTMLElement[] {
    return [...document.querySelectorAll<HTMLElement>(`[data-gallery="${CSS.escape(gallery)}"]`)].sort(
      (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
    );
  }

  function collect(els: HTMLElement[]): Item[] {
    return els.map((el) => ({
        full: el.dataset.full ?? '',
        title: el.dataset.title ?? '',
        meta: el.dataset.meta ?? '',
        alt: el.querySelector('img')?.alt ?? el.dataset.title ?? '',
      }));
  }

  function apply() {
    image.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    root.classList.toggle('is-zoomed', scale > 1.01);
    zoomLabel.textContent = `${Math.round(scale * 100)}%`;
  }

  // Lo zoom avviene attorno a un punto (cx, cy) espresso in coordinate dello schermo.
  function zoomTo(next: number, cx?: number, cy?: number) {
    next = Math.min(MAX, Math.max(1, next));
    if (next === 1) {
      scale = 1;
      tx = ty = 0;
      apply();
      return;
    }
    const r = image.getBoundingClientRect();
    const baseLeft = r.left - tx;
    const baseTop = r.top - ty;
    const px = (cx ?? r.left + r.width / 2) - baseLeft;
    const py = (cy ?? r.top + r.height / 2) - baseTop;
    // punto dell'immagine sotto il cursore (in coordinate non scalate)
    const ix = (px - tx) / scale;
    const iy = (py - ty) / scale;
    scale = next;
    tx = px - ix * scale;
    ty = py - iy * scale;
    clamp();
    apply();
  }

  function clamp() {
    const w = image.offsetWidth;
    const h = image.offsetHeight;
    const sw = stage.clientWidth;
    const sh = stage.clientHeight;
    const ow = w * scale;
    const oh = h * scale;
    const left0 = image.offsetLeft;
    const top0 = image.offsetTop;
    // se l'immagine ingrandita è più grande dello spazio, non lasciare bordi vuoti
    const minX = ow > sw ? sw - ow - left0 : (sw - ow) / 2 - left0;
    const maxX = ow > sw ? -left0 : (sw - ow) / 2 - left0;
    const minY = oh > sh ? sh - oh - top0 : (sh - oh) / 2 - top0;
    const maxY = oh > sh ? -top0 : (sh - oh) / 2 - top0;
    tx = Math.min(maxX, Math.max(minX, tx));
    ty = Math.min(maxY, Math.max(minY, ty));
  }

  function show(i: number) {
    if (!items.length) return;
    index = (i + items.length) % items.length;
    const it = items[index];
    scale = 1;
    tx = ty = 0;
    apply();
    image.classList.remove('is-ready');
    image.onload = () => image.classList.add('is-ready');
    image.src = it.full;
    image.alt = it.alt;
    if (image.complete) image.classList.add('is-ready');
    titleEl.textContent = it.title;
    metaEl.textContent = it.meta;
    countEl.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
    // precarica le immagini vicine
    [index + 1, index - 1].forEach((j) => {
      const n = items[(j + items.length) % items.length];
      if (n) new Image().src = n.full;
    });
  }

  function open(from: HTMLElement) {
    const els = elements(from.dataset.gallery!);
    items = collect(els);
    const i = Math.max(0, els.indexOf(from));
    lastFocus = from;
    root.hidden = false;
    root.classList.toggle('is-single', items.length < 2);
    document.documentElement.style.overflow = 'hidden';
    show(i);
    q<HTMLButtonElement>('[data-lb-close]').focus();
  }

  function close() {
    root.hidden = true;
    image.removeAttribute('src');
    document.documentElement.style.overflow = '';
    lastFocus?.focus();
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-gallery]');
    if (!el) return;
    e.preventDefault();
    open(el);
  });

  q('[data-lb-close]').addEventListener('click', close);
  q('[data-lb-prev]').addEventListener('click', () => show(index - 1));
  q('[data-lb-next]').addEventListener('click', () => show(index + 1));
  q('[data-lb-zoomin]').addEventListener('click', () => zoomTo(scale * 1.6));
  q('[data-lb-zoomout]').addEventListener('click', () => zoomTo(scale / 1.6));

  document.addEventListener('keydown', (e) => {
    if (root.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft' && scale === 1) show(index - 1);
    else if (e.key === 'ArrowRight' && scale === 1) show(index + 1);
    else if (e.key === '+' || e.key === '=') zoomTo(scale * 1.6);
    else if (e.key === '-') zoomTo(scale / 1.6);
    else if (e.key === 'Tab') {
      // tieni il focus dentro il visualizzatore
      const f = [...root.querySelectorAll<HTMLElement>('button')].filter((b) => b.offsetParent !== null);
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Rotella del mouse: zoom
  stage.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      zoomTo(scale * (e.deltaY < 0 ? 1.15 : 1 / 1.15), e.clientX, e.clientY);
    },
    { passive: false },
  );

  // Trascinamento, scorrimento col dito, pizzico per ingrandire, doppio clic/tocco
  const pointers = new Map<number, { x: number; y: number }>();
  let startX = 0;
  let startY = 0;
  let startTx = 0;
  let startTy = 0;
  let pinchDist = 0;
  let pinchScale = 1;
  let moved = false;
  let lastTap = 0;
  let downTarget: EventTarget | null = null;

  stage.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('button')) return;
    downTarget = e.target;
    stage.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved = false;
    if (pointers.size === 1) {
      startX = e.clientX;
      startY = e.clientY;
      startTx = tx;
      startTy = ty;
    } else if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      pinchScale = scale;
    }
  });

  stage.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchDist > 0) zoomTo(pinchScale * (d / pinchDist), (a.x + b.x) / 2, (a.y + b.y) / 2);
      moved = true;
      return;
    }
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
    if (scale > 1) {
      tx = startTx + dx;
      ty = startTy + dy;
      clamp();
      apply();
    }
  });

  const end = (e: PointerEvent) => {
    if (!pointers.has(e.pointerId)) return;
    const wasPinch = pointers.size > 1;
    pointers.delete(e.pointerId);
    if (wasPinch) {
      // dopo un pizzico, riprendi il trascinamento dal dito rimasto
      const rest = [...pointers.values()][0];
      if (rest) {
        startX = rest.x;
        startY = rest.y;
        startTx = tx;
        startTy = ty;
      }
      return;
    }
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (scale === 1 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
      show(index + (dx < 0 ? 1 : -1));
      return;
    }
    if (!moved) {
      const now = Date.now();
      if (now - lastTap < 300) {
        zoomTo(scale > 1 ? 1 : 2.5, e.clientX, e.clientY);
        lastTap = 0;
      } else {
        lastTap = now;
        // un tocco sullo sfondo (fuori dall'immagine) chiude
        if (downTarget === stage && scale === 1) {
          const t = now;
          setTimeout(() => {
            if (lastTap === t) close();
          }, 300);
        }
      }
    }
  };
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', (e) => pointers.delete(e.pointerId));

  window.addEventListener('resize', () => {
    if (!root.hidden && scale > 1) {
      clamp();
      apply();
    }
  });
</script>
