---
// Un'immagine cliccabile che si apre nel visualizzatore a schermo intero.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  gallery: string;
  index: number;
  title?: string;
  meta?: string;
  /** larghezza indicativa sullo schermo, per scegliere la dimensione giusta */
  sizes?: string;
  caption?: boolean;
  label?: string;
  class?: string;
  style?: string;
}
const { src, alt, gallery, index, title = '', meta = '', sizes = '(max-width: 760px) 100vw, 33vw', caption = false, label, class: cls, style } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp', quality: 82 });
const widths = [400, 640, 900, 1200].filter((w) => w < src.width).concat(Math.min(src.width, 1400));
---

<button
  type="button"
  class:list={['work', cls]}
  style={style}
  data-gallery={gallery}
  data-index={index}
  data-full={full.src}
  data-title={title}
  data-meta={meta}
  aria-label={label ?? ([title, meta].filter(Boolean).join(', ') || alt)}
>
  <Image src={src} alt={alt} widths={[...new Set(widths)]} sizes={sizes} format="webp" quality={80} loading="lazy" decoding="async" />
  {
    caption && (
      <>
        <span class="cap-title">{title}</span>
        {meta && <span class="cap-year">{meta}</span>}
      </>
    )
  }
</button>
