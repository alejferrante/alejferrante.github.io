---
import { LANGS, LANG_LABELS, LANG_NAMES, href, t, type Lang, type UiKey } from '../i18n/ui';
import { settings, pageShown } from '../lib/data';

interface Props {
  lang: Lang;
  path: string;
  hero?: boolean;
}
const { lang, path, hero = false } = Astro.props;

type Look = { color?: string; opacity?: number; text_color?: string };
const nav = await settings<{ over_painting?: Look; after_scroll?: Look }>('navbar');
const [showAwards, showPress] = await Promise.all([pageShown('awards'), pageShown('press')]);

function rgba(hex = '#161616', opacity = 100) {
  let h = String(hex).replace('#', '').trim();
  if (h.length === 3) h = h.split('').map((c) => c + c).join('');
  const n = parseInt(h.slice(0, 6), 16);
  const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  const a = Math.max(0, Math.min(100, Number(opacity ?? 100))) / 100;
  return `rgba(${r}, ${g}, ${b}, ${a})`;
}
const top = nav.over_painting ?? {};
const after = nav.after_scroll ?? {};
const style = [
  `--nav-bg-top:${rgba(top.color ?? '#161616', top.opacity ?? 0)}`,
  `--nav-fg-top:${top.text_color ?? '#FFFFFF'}`,
  `--nav-bg:${rgba(after.color ?? '#FAFAF8', after.opacity ?? 96)}`,
  `--nav-fg:${after.text_color ?? '#161616'}`,
  // la linea sotto la barra compare solo se la barra è quasi opaca
  `--nav-line:${(after.opacity ?? 96) > 60 ? 'rgba(22,22,22,0.08)' : 'transparent'}`,
].join(';');

const home = href(lang, '');
// Stampa e Premi compaiono nel menu solo se sono accesi nel pannello.
const links = [
  { key: 'biography', href: `${home}#biography`, match: '' },
  { key: 'paintings', href: `${home}#paintings`, match: 'paintings' },
  { key: 'exhibitions', href: href(lang, 'exhibitions'), match: 'exhibitions' },
  { key: 'books', href: href(lang, 'books'), match: 'books' },
  showAwards && { key: 'awards', href: href(lang, 'awards'), match: 'awards' },
  showPress && { key: 'press', href: href(lang, 'press'), match: 'press' },
  { key: 'video', href: href(lang, 'video'), match: 'video' },
  { key: 'reviews', href: href(lang, 'reviews'), match: 'reviews' },
].filter((l): l is { key: UiKey; href: string; match: string } => !!l);
const isCurrent = (m: string) => !!m && (path === m || path.startsWith(`${m}/`));
---

<header
  class:list={['nav', { 'is-hero': hero }]}
  style={style}
  data-nav
>
  <div class="nav-inner">
    <a class="nav-name" href={home}>Alejandro Juan Ferrante</a>

    <nav class="nav-links" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
            {t(lang, l.key)}
          </a>
        ))
      }
      <span class="nav-langs" aria-label={t(lang, 'language')}>
        {
          LANGS.map((l) => (
            <a href={href(l, path)} hreflang={l} lang={l} title={LANG_NAMES[l]} aria-current={l === lang ? 'true' : undefined}>
              {LANG_LABELS[l]}
            </a>
          ))
        }
      </span>
    </nav>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="sr-only">{t(lang, 'menu')}</span>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
        <path d="M3 8h18M3 16h18"></path>
      </svg>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden data-menu>
  <div class="mm-top">
    <a class="nav-name" href={home}>Alejandro Juan Ferrante</a>
    <button class="nav-toggle" type="button" data-menu-close>
      <span class="sr-only">{t(lang, 'closeMenu')}</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </div>
  <nav class="mm-links" aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
          {t(lang, l.key)}
        </a>
      ))
    }
  </nav>
  <div class="mm-langs">
    {
      LANGS.map((l) => (
        <a href={href(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
          {LANG_NAMES[l]}
        </a>
      ))
    }
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--nav-bg);
    color: var(--nav-fg);
    border-bottom: 1px solid var(--nav-line);
    transition:
      background-color 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease;
  }
  .nav.is-hero:not(.is-scrolled) {
    background: var(--nav-bg-top);
    color: var(--nav-fg-top);
    border-bottom-color: transparent;
  }
  .nav-inner {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-name {
    font-family: var(--serif);
    font-size: 22px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: inherit;
  }
  .nav a:hover {
    color: inherit;
    opacity: 0.65;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav-links a {
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }
  .nav-links a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .nav-langs {
    display: flex;
    gap: 10px;
    margin-left: 6px;
    padding-left: 18px;
    border-left: 1px solid currentColor;
    border-left-color: color-mix(in srgb, currentColor 35%, transparent);
  }
  .nav-langs a {
    opacity: 0.6;
  }
  .nav-langs a[aria-current='true'] {
    opacity: 1;
    border-bottom-color: currentColor;
  }
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 1120px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter) 32px;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mm-top {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
  }
  .mm-top .nav-toggle {
    display: flex;
  }
  .mm-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 40px 0;
    flex: 1;
  }
  .mm-links a {
    font-family: var(--serif);
    font-size: clamp(32px, 8vw, 44px);
    line-height: 1.25;
  }
  .mm-langs {
    display: flex;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .mm-langs a {
    color: var(--muted);
    padding: 8px 0;
  }
  .mm-langs a[aria-current='true'] {
    color: var(--ink);
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Barra: aspetto "sopra il quadro" finché il quadro della home è visibile.
  if (nav?.classList.contains('is-hero')) {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const update = () => {
      const limit = (hero?.offsetHeight ?? window.innerHeight) - nav.offsetHeight - 1;
      nav.classList.toggle('is-scrolled', window.scrollY > limit);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Menu su telefono
  const setMenu = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
</script>
