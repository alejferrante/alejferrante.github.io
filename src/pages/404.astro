---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const lang = 'en' as const;
---

<Base lang={lang} path="404" title={t(lang, 'notFound')}>
  <section class="nf">
    <p class="eyebrow">404</p>
    <h1>{t(lang, 'notFound')}</h1>
    <a class="link-line" href="/">{t(lang, 'backHome')} →</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
    padding: calc(var(--nav-h) + 64px) var(--gutter) 64px;
  }
  .nf h1 {
    font-style: italic;
    font-size: clamp(40px, 5vw, 56px);
  }
</style>
