---
import Base from '../../layouts/Base.astro';
import Zoomable from '../../components/Zoomable.astro';
import { langPaths, t, type Lang } from '../../i18n/ui';
import { paintings, settings, workMeta, youtubeId } from '../../lib/data';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const data = await settings<{ videos?: { youtube?: string; painting?: string }[] }>('videos');
const works = await paintings();
const rows = (data.videos ?? []).map((v) => ({
  id: youtubeId(v.youtube),
  work: works.find((w) => w.id === v.painting),
}));
---

<Base lang={lang} path="video" title={t(lang, 'video')}>
  <div class="wrap">
    <div class="page-head">
      <h1>{t(lang, 'video')}</h1>
      <p>{t(lang, 'videoIntro')}</p>
    </div>

    {
      rows.map((r, i) => (
        <section class="row">
          {r.work && (
            <div class="row-work">
              <Zoomable
                src={r.work.image}
                alt={`${r.work.title}${r.work.year ? `, ${r.work.year}` : ''}`}
                gallery="video"
                index={i}
                title={r.work.title}
                meta={workMeta(r.work, lang)}
                caption
                sizes="(max-width: 760px) 100vw, 360px"
              />
            </div>
          )}
          <div class="row-video yt-box">
            {r.id ? (
              <button
                type="button"
                class="yt"
                data-yt={r.id}
                aria-label={`${t(lang, 'playVideo')}${r.work ? ` — ${r.work.title}` : ''}`}
              >
                <img src={`https://i.ytimg.com/vi/${r.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
                <span class="play" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
                    <path d="M8 5l11 7-11 7z" />
                  </svg>
                </span>
              </button>
            ) : (
              <div class="yt empty">
                <span>{t(lang, 'videoSoon')}</span>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 56px;
    padding: clamp(40px, 6vw, 72px) 0;
    border-bottom: 1px solid var(--line);
  }
  .row:first-of-type {
    padding-top: 0;
  }
  .row-work {
    flex: 1 1 260px;
    max-width: 360px;
  }
  .row-video {
    flex: 999 1 520px;
    min-width: 0;
  }
  .yt-box {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #1e1c1a;
  }
  .yt {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #1e1c1a;
    cursor: pointer;
    overflow: hidden;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.25s ease;
  }
  .yt:hover img {
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 1px solid rgba(250, 250, 248, 0.8);
    background: rgba(22, 22, 22, 0.4);
    color: #fafaf8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .yt.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    color: #a79e91;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    padding: 24px;
  }
  /* Telefono: quadro piccolo accanto al titolo e video meno largo, così ogni video occupa meno spazio. */
  @media (max-width: 760px) {
    .row {
      gap: 20px;
      padding: 36px 0;
    }
    .row-work {
      flex: 1 1 100%;
      max-width: none;
    }
    .row-work :global(.work) {
      display: grid;
      grid-template-columns: 34% 1fr;
      grid-template-rows: 1fr auto;
      column-gap: 16px;
    }
    .row-work :global(.work img) {
      grid-row: 1 / 3;
    }
    .row-work :global(.cap-title) {
      align-self: end;
      margin-top: 0;
      font-size: 18px;
    }
    .row-work :global(.cap-year) {
      grid-column: 2;
    }
    .row-video {
      flex: none;
      width: 82%;
    }
    .play {
      width: 56px;
      height: 56px;
    }
  }
  .yt-box :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Il video di YouTube viene caricato solo quando si preme "play": pagina più leggera e più rispettosa della privacy.
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = btn.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>
